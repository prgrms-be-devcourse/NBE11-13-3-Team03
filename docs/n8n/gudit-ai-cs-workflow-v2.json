        "url": "={{$env.CS_SLACK_WEBHOOK_URL}}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "={{ `*[Gudit CS 문의 분석]*\n\n*고객 문의*\n${$('Webhook').item.json.body.message}\n\n*주문번호*\n${$('Webhook').item.json.body.orderId}\n\n*문의 유형*\n${$json.category}\n\n*현재 상태*\n${$json.currentState}\n\n*판단*\n${$json.assessment}\n\n*권장 조치*\n${$json.recommendedAction}\n\n*고객 답변 초안*\n${$json.customerReplyDraft}` }}"
            }
          ]
